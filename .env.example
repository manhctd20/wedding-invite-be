# ===== Biến dùng chung cho docker-compose.prod.yml =====
# Copy file này thành .env rồi đổi giá trị cho "production":
#   cp .env.example .env

# --- Postgres ---
DB_USER=wedding
DB_PASSWORD=doi_mat_khau_manh_o_day
DB_NAME=wedding_invite

# --- Backend / JWT ---
JWT_SECRET=doi_thanh_chuoi_bi_mat_that_dai_va_ngau_nhien
JWT_EXPIRES=7d

# CORS: cùng origin qua nginx nên chỉ cần host truy cập.
# Nhiều origin ngăn cách bằng dấu phẩy. Đổi 'localhost' thành IP/tên miền server thật.
CORS_ORIGIN=http://localhost

# --- Cổng web (nginx) mở ra ngoài ---
# 80 = giống server thật. Nếu 80 bị chiếm trên WSL, đổi thành 8080.
WEB_PORT=80
